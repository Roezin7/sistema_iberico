generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
//  NÚCLEO MULTI-NEGOCIO + AUTH (Fase 1)
// ===========================================================================

enum RolUsuario {
  admin
  empleado
}

model negocios {
  id           BigInt   @id @default(autoincrement())
  nombre       String
  tipo         String?
  zona_horaria String   @default("America/Mexico_City")
  creado_at    DateTime @default(now()) @db.Timestamptz(6)

  usuarios           usuarios[]
  socios             socios[]
  stores             stores[]
  products           products[]
  inventory_snapshot inventory_snapshot[]
  purchases          purchases[]
  zonas_inventario   zonas_inventario[]
  categorias_inventario categorias_inventario[]
  ubicaciones_fondos ubicaciones_fondos[]
  categorias_gasto   categorias_gasto[]
  semanas            semanas[]
  inventario_semanal inventario_semanal[]
  conciliaciones_diarias conciliaciones_diarias[]
  epos_importaciones  epos_importaciones[]
  epos_ventas         epos_ventas[]
  movimientos        movimientos[]
  arqueos            arqueos[]
  saldos_iniciales   saldos_iniciales[]
  pasivos            pasivos[]
  snapshots_patrimonio snapshots_patrimonio[]
  checklists         checklists[]
  silvia_mensajes    silvia_mensajes[]
  silvia_memoria     silvia_memoria[]
  productos_menu     productos_menu[]
}

model usuarios {
  id          BigInt        @id @default(autoincrement())
  negocio_id  BigInt
  nombre      String
  rol         RolUsuario    @default(empleado)
  pin_hash    String
  activo      Boolean       @default(true)
  creado_at   DateTime      @default(now()) @db.Timestamptz(6)
  negocios    negocios      @relation(fields: [negocio_id], references: [id])
  movimientos movimientos[]
  arqueos     arqueos[]
  checklist_item_resultados checklist_item_resultados[]
  conciliaciones_diarias conciliaciones_diarias[]

  @@index([negocio_id])
}

model socios {
  id                 BigInt               @id @default(autoincrement())
  negocio_id         BigInt
  nombre             String
  activo             Boolean              @default(true)
  negocios           negocios             @relation(fields: [negocio_id], references: [id])
  ubicaciones_fondos ubicaciones_fondos[]
  movimientos        movimientos[]

  @@index([negocio_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ingests {
  id                      BigInt   @id @default(autoincrement())
  chat_id                 BigInt
  mode                    String
  telegram_file_id        String
  telegram_file_unique_id String?
  mime_type               String?
  file_name               String?
  file_size               Int?
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  status                  String   @default("pending")
  error                   String?
}

model inventory_lines {
  snapshot_id        BigInt
  product_id         BigInt
  zona_id            BigInt
  qty_captura        Decimal            @default(0) @db.Decimal(12, 2)
  // Factor aplicado AL MOMENTO de capturar (snapshot de product_zone_units.factor).
  // Histórico = 1 (los datos viejos ya estaban en unidad base). total_base = qty_captura * factor.
  factor             Decimal            @default(1) @db.Decimal(12, 4)
  products           products           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_snapshot inventory_snapshot @relation(fields: [snapshot_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zonas_inventario   zonas_inventario   @relation(fields: [zona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([snapshot_id, product_id, zona_id])
  @@index([zona_id])
}

// ===========================================================================
//  INVENTARIO v2 — zonas configurables + unidades de captura (Fase 2)
// ===========================================================================

model zonas_inventario {
  id         BigInt   @id @default(autoincrement())
  negocio_id BigInt
  nombre     String
  orden      Int      @default(0)
  negocios   negocios @relation(fields: [negocio_id], references: [id])

  inventory_lines    inventory_lines[]
  product_zone_units product_zone_units[]

  @@unique([negocio_id, nombre])
  @@index([negocio_id])
}

model product_zone_units {
  id             BigInt           @id @default(autoincrement())
  product_id     BigInt
  zona_id        BigInt
  unidad_captura String
  factor         Decimal          @default(1) @db.Decimal(12, 4)
  products       products         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  zonas_inventario zonas_inventario @relation(fields: [zona_id], references: [id], onDelete: Cascade)

  @@unique([product_id, zona_id])
  @@index([zona_id])
}

model producto_costos_historicos {
  id         BigInt   @id @default(autoincrement())
  product_id BigInt
  fecha      DateTime @db.Date
  costo      Decimal  @db.Decimal(12, 2)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model inventory_snapshot {
  id              BigInt            @id @default(autoincrement())
  negocio_id      BigInt
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  inventory_lines inventory_lines[]
  negocios        negocios          @relation(fields: [negocio_id], references: [id])
  aperturas_semanales inventario_semanal[] @relation("InventarioSemanalApertura")
  cierres_semanales   inventario_semanal[] @relation("InventarioSemanalCierre")

  @@index([negocio_id])
}

model product_aliases {
  id         BigInt   @id @default(autoincrement())
  product_id BigInt
  alias      String   @unique
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_aliases_product_id")
}

model products {
  id              BigInt            @id @default(autoincrement())
  negocio_id      BigInt
  name            String
  store_id        BigInt
  base_qty        Decimal           @default(0) @db.Decimal(12, 2)
  active          Boolean           @default(true)
  unit_cost       Decimal?          @db.Decimal(12, 2)
  // Presentación de compra y unidad real para recetas (ml, g o pieza).
  // Se dejan opcionales para no invalidar el catálogo histórico mientras se
  // completa la matriz de costeo.
  unidad_base       String?
  contenido_compra  Decimal?         @db.Decimal(14, 4)
  unidad_compra     String?
  rendimiento_util  Decimal          @default(1) @db.Decimal(8, 4)
  categoria_id    BigInt?
  inventory_lines inventory_lines[]
  product_aliases product_aliases[]
  stores          stores            @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  negocios        negocios          @relation(fields: [negocio_id], references: [id])
  categorias_inventario categorias_inventario? @relation(fields: [categoria_id], references: [id])
  purchase_lines  purchase_lines[]
  product_zone_units product_zone_units[]
  producto_costos_historicos producto_costos_historicos[]
  receta_lineas     receta_lineas[]

  @@unique([negocio_id, name])
  @@index([negocio_id])
}

model categorias_inventario {
  id         BigInt     @id @default(autoincrement())
  negocio_id BigInt
  nombre     String
  orden      Int        @default(0)
  activo     Boolean    @default(true)
  negocios   negocios   @relation(fields: [negocio_id], references: [id])
  products   products[]

  @@unique([negocio_id, nombre])
  @@index([negocio_id])
}

model purchase_lines {
  purchase_id BigInt
  product_id  BigInt
  qty         Decimal   @default(0) @db.Decimal(12, 2)
  products    products  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchases   purchases @relation(fields: [purchase_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([purchase_id, product_id])
}

model purchases {
  id             BigInt           @id @default(autoincrement())
  negocio_id     BigInt
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  purchase_lines purchase_lines[]
  negocios       negocios         @relation(fields: [negocio_id], references: [id])

  @@index([negocio_id])
}

model stores {
  id         BigInt     @id @default(autoincrement())
  negocio_id BigInt
  name       String
  products   products[]
  negocios   negocios   @relation(fields: [negocio_id], references: [id])

  @@unique([negocio_id, name])
  @@index([negocio_id])
}

// ===========================================================================
//  MENÚ Y COSTEO — recetas versionadas (Fase Ibérico)
// ===========================================================================

/// Producto que se vende en el menú y que puede vincularse con Epos Now.
/// El precio de venta es informativo; la venta real se toma del POS.
model productos_menu {
  id              BigInt    @id @default(autoincrement())
  negocio_id      BigInt
  nombre          String
  epos_product_id Int?
  precio_venta    Decimal?  @db.Decimal(12, 2)
  activo          Boolean   @default(true)
  creado_at       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_at  DateTime  @updatedAt @db.Timestamptz(6)
  negocios        negocios  @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  recetas         recetas[]

  @@unique([negocio_id, nombre])
  @@index([negocio_id, activo])
  @@index([epos_product_id])
}

/// Una versión de receta. Se conserva para no reescribir costos históricos.
model recetas {
  id                BigInt         @id @default(autoincrement())
  producto_menu_id  BigInt
  version           Int            @default(1)
  estado            String         @default("borrador")
  fuente            String?
  notas             String?
  vigente_desde     DateTime?      @db.Date
  creado_at         DateTime       @default(now()) @db.Timestamptz(6)
  actualizado_at    DateTime       @updatedAt @db.Timestamptz(6)
  productos_menu    productos_menu @relation(fields: [producto_menu_id], references: [id], onDelete: Cascade)
  lineas            receta_lineas[]

  @@unique([producto_menu_id, version])
  @@index([producto_menu_id, estado])
}

/// Ingrediente consumido por una receta. La unidad explícita evita mezclar ml,
/// g, piezas y unidades de compra.
model receta_lineas {
  receta_id   BigInt
  product_id  BigInt
  cantidad    Decimal  @db.Decimal(12, 4)
  unidad      String
  nota        String?
  recetas     recetas  @relation(fields: [receta_id], references: [id], onDelete: Cascade)
  products    products  @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@id([receta_id, product_id])
  @@index([product_id])
}

// ===========================================================================
//  FINANZAS (Fase 3)
// ===========================================================================

enum TipoUbicacion {
  banco
  efectivo
}

enum EstadoSemana {
  abierta
  cerrada
}

enum TipoMovimiento {
  venta_efectivo
  venta_tarjeta
  propina_tarjeta
  comision_terminal
  gasto
  sueldo
  compra_inventario
  transferencia
  retiro_socio
  deposito
  propina_pagada
}

model ubicaciones_fondos {
  id         BigInt        @id @default(autoincrement())
  negocio_id BigInt
  nombre     String
  tipo       TipoUbicacion
  socio_id   BigInt?
  activo     Boolean       @default(true)
  negocios   negocios      @relation(fields: [negocio_id], references: [id])
  socios     socios?       @relation(fields: [socio_id], references: [id])

  mov_origen       movimientos[]      @relation("mov_origen")
  mov_destino      movimientos[]      @relation("mov_destino")
  arqueos          arqueos[]
  saldos_iniciales saldos_iniciales[]
  cierres_semana   cierres_semana[]

  @@index([negocio_id])
}

model categorias_gasto {
  id          BigInt        @id @default(autoincrement())
  negocio_id  BigInt
  nombre      String
  activo      Boolean       @default(true)
  negocios    negocios      @relation(fields: [negocio_id], references: [id])
  movimientos movimientos[]

  @@unique([negocio_id, nombre])
  @@index([negocio_id])
}

model semanas {
  id           BigInt           @id @default(autoincrement())
  negocio_id   BigInt
  etiqueta     String
  fecha_inicio DateTime         @db.Date
  fecha_fin    DateTime         @db.Date
  estado       EstadoSemana     @default(abierta)
  cerrada_at   DateTime?        @db.Timestamptz(6)
  negocios     negocios         @relation(fields: [negocio_id], references: [id])
  movimientos  movimientos[]
  arqueos      arqueos[]
  cierres      cierres_semana[]
  conciliaciones_diarias conciliaciones_diarias[]
  inventario_semanal inventario_semanal?

  @@unique([negocio_id, fecha_inicio])
  @@index([negocio_id])
}

/// Cadena semanal de inventario. El cierre de una semana es la apertura de la
/// siguiente; los snapshots históricos siguen siendo inmutables y pueden
/// reutilizarse como apertura inicial durante la transición.
model inventario_semanal {
  id                   BigInt              @id @default(autoincrement())
  negocio_id           BigInt
  semana_id            BigInt              @unique
  apertura_snapshot_id BigInt?
  cierre_snapshot_id   BigInt?
  apertura_valor       Decimal?            @db.Decimal(12, 2)
  cierre_valor         Decimal?            @db.Decimal(12, 2)
  apertura_origen      String?
  creado_at            DateTime            @default(now()) @db.Timestamptz(6)
  actualizado_at       DateTime            @updatedAt @db.Timestamptz(6)
  negocios             negocios            @relation(fields: [negocio_id], references: [id])
  semanas              semanas             @relation(fields: [semana_id], references: [id], onDelete: Cascade)
  apertura_snapshot    inventory_snapshot? @relation("InventarioSemanalApertura", fields: [apertura_snapshot_id], references: [id])
  cierre_snapshot      inventory_snapshot? @relation("InventarioSemanalCierre", fields: [cierre_snapshot_id], references: [id])

  @@index([negocio_id])
  @@index([apertura_snapshot_id])
  @@index([cierre_snapshot_id])
}

enum EstadoConciliacionDiaria {
  revision
  confirmada
}

/// Evidencia diaria de Epos y confirmación humana del saldo.
/// No sustituye movimientos financieros ni modifica Epos Now.
model conciliaciones_diarias {
  id                 BigInt                   @id @default(autoincrement())
  negocio_id         BigInt
  semana_id          BigInt
  fecha              DateTime                 @db.Date
  estado             EstadoConciliacionDiaria @default(revision)
  epos_ventas        Decimal                  @db.Decimal(12, 2)
  epos_efectivo      Decimal                  @default(0) @db.Decimal(12, 2)
  epos_tarjeta       Decimal                  @default(0) @db.Decimal(12, 2)
  epos_otros         Decimal                  @default(0) @db.Decimal(12, 2)
  confirmado_ventas  Decimal?
  confirmado_efectivo Decimal?
  confirmado_tarjeta Decimal?
  confirmado_otros   Decimal?
  cuentas_abiertas   Decimal                  @default(0) @db.Decimal(12, 2)
  excepciones_json   String?
  notas              String?
  usuario_id         BigInt?
  creado_at          DateTime                 @default(now()) @db.Timestamptz(6)
  confirmado_at      DateTime?                @db.Timestamptz(6)
  negocios           negocios                 @relation(fields: [negocio_id], references: [id])
  semanas            semanas                  @relation(fields: [semana_id], references: [id])
  usuarios           usuarios?                @relation(fields: [usuario_id], references: [id])

  @@unique([negocio_id, fecha])
  @@index([semana_id])
  @@index([negocio_id])
}

/// Importaciones de solo lectura desde Epos Now. Se conserva el periodo y el
/// payload para poder auditar cualquier cifra antes de confirmar un cierre.
model epos_importaciones {
  id                 BigInt   @id @default(autoincrement())
  negocio_id         BigInt
  clave              String
  location_id        Int?
  periodo_desde      DateTime @db.Timestamptz(6)
  periodo_hasta      DateTime @db.Timestamptz(6)
  estado             String   @default("completada")
  filas_recibidas    Int      @default(0)
  filas_nuevas       Int      @default(0)
  filas_duplicadas   Int      @default(0)
  payload_json       String?
  creado_at          DateTime @default(now()) @db.Timestamptz(6)
  negocios           negocios @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  epos_ventas        epos_ventas[]

  @@unique([negocio_id, clave])
  @@index([negocio_id, periodo_desde])
}

/// Línea normalizada de venta de Epos Now. No modifica inventario: sólo crea
/// la base auditable para costeo, merma y conciliación posterior.
model epos_ventas {
  id                    BigInt   @id @default(autoincrement())
  negocio_id            BigInt
  importacion_id        BigInt
  clave                 String
  epos_transaction_id   Int?
  epos_item_id          Int?
  fecha                 DateTime @db.Timestamptz(6)
  epos_product_id       Int?
  producto_nombre       String
  cantidad              Decimal  @db.Decimal(12, 4)
  venta_bruta           Decimal  @db.Decimal(12, 2)
  venta_neta            Decimal? @db.Decimal(12, 2)
  descuento             Decimal  @default(0) @db.Decimal(12, 2)
  metodo_pago           String
  raw_json              String?
  creado_at             DateTime @default(now()) @db.Timestamptz(6)
  negocios              negocios @relation(fields: [negocio_id], references: [id], onDelete: Cascade)
  importacion           epos_importaciones @relation(fields: [importacion_id], references: [id], onDelete: Cascade)

  @@unique([negocio_id, clave])
  @@index([negocio_id, fecha])
  @@index([importacion_id])
  @@index([negocio_id, epos_product_id])
}

model movimientos {
  id                   BigInt              @id @default(autoincrement())
  negocio_id           BigInt
  semana_id            BigInt
  fecha                DateTime            @db.Date
  tipo                 TipoMovimiento
  monto                Decimal             @db.Decimal(12, 2)
  ubicacion_origen_id  BigInt?
  ubicacion_destino_id BigInt?
  categoria_id         BigInt?
  socio_id             BigInt?
  facturado            Boolean             @default(false)
  descripcion          String?
  usuario_id           BigInt
  creado_at            DateTime            @default(now()) @db.Timestamptz(6)
  negocios             negocios            @relation(fields: [negocio_id], references: [id])
  semanas              semanas             @relation(fields: [semana_id], references: [id])
  ubicacion_origen     ubicaciones_fondos? @relation("mov_origen", fields: [ubicacion_origen_id], references: [id])
  ubicacion_destino    ubicaciones_fondos? @relation("mov_destino", fields: [ubicacion_destino_id], references: [id])
  categorias_gasto     categorias_gasto?   @relation(fields: [categoria_id], references: [id])
  socios               socios?             @relation(fields: [socio_id], references: [id])
  usuarios             usuarios            @relation(fields: [usuario_id], references: [id])

  @@index([negocio_id])
  @@index([semana_id])
}

model arqueos {
  id           BigInt             @id @default(autoincrement())
  negocio_id   BigInt
  semana_id    BigInt
  fecha        DateTime           @db.Date
  ubicacion_id BigInt
  monto_real   Decimal            @db.Decimal(12, 2)
  usuario_id   BigInt
  creado_at    DateTime           @default(now()) @db.Timestamptz(6)
  negocios     negocios           @relation(fields: [negocio_id], references: [id])
  semanas      semanas            @relation(fields: [semana_id], references: [id])
  ubicaciones  ubicaciones_fondos @relation(fields: [ubicacion_id], references: [id])
  usuarios     usuarios           @relation(fields: [usuario_id], references: [id])

  @@index([semana_id])
  @@index([negocio_id])
}

// Bootstrap: saldo inicial por ubicación, fijado UNA sola vez (no editable).
model saldos_iniciales {
  id           BigInt             @id @default(autoincrement())
  negocio_id   BigInt
  ubicacion_id BigInt             @unique
  monto        Decimal            @db.Decimal(12, 2)
  negocios     negocios           @relation(fields: [negocio_id], references: [id])
  ubicaciones  ubicaciones_fondos @relation(fields: [ubicacion_id], references: [id])

  @@index([negocio_id])
}

// Saldo de cierre por ubicación, congelado al cerrar la semana (encadena con la siguiente).
model cierres_semana {
  id            BigInt             @id @default(autoincrement())
  semana_id     BigInt
  ubicacion_id  BigInt
  saldo_inicial Decimal            @db.Decimal(12, 2)
  saldo_teorico Decimal            @db.Decimal(12, 2)
  saldo_real    Decimal?           @db.Decimal(12, 2)
  saldo_final   Decimal            @db.Decimal(12, 2)
  semanas       semanas            @relation(fields: [semana_id], references: [id])
  ubicaciones   ubicaciones_fondos @relation(fields: [ubicacion_id], references: [id])

  @@unique([semana_id, ubicacion_id])
}

// ===========================================================================
//  PATRIMONIO (Fase 4)
// ===========================================================================

model pasivos {
  id         BigInt   @id @default(autoincrement())
  negocio_id BigInt
  nombre     String
  monto      Decimal  @db.Decimal(12, 2)
  tipo       String?
  activo     Boolean  @default(true)
  negocios   negocios @relation(fields: [negocio_id], references: [id])

  @@index([negocio_id])
}

model snapshots_patrimonio {
  id               BigInt   @id @default(autoincrement())
  negocio_id       BigInt
  fecha            DateTime @db.Date
  total_banco      Decimal  @db.Decimal(12, 2)
  total_efectivo   Decimal  @db.Decimal(12, 2)
  total_inventario Decimal  @db.Decimal(12, 2)
  total_pasivos    Decimal  @db.Decimal(12, 2)
  patrimonio_neto  Decimal  @db.Decimal(12, 2)
  creado_at        DateTime @default(now()) @db.Timestamptz(6)
  negocios         negocios @relation(fields: [negocio_id], references: [id])

  @@unique([negocio_id, fecha])
  @@index([negocio_id])
}

// ===========================================================================
//  TAREAS — checklists apertura/cierre (Fase 5)
// ===========================================================================

enum TipoChecklist {
  apertura
  cierre
}

model checklists {
  id         BigInt                 @id @default(autoincrement())
  negocio_id BigInt
  nombre     String
  tipo       TipoChecklist
  activo     Boolean                @default(true)
  negocios   negocios               @relation(fields: [negocio_id], references: [id])
  items      checklist_items[]
  instancias checklist_instancias[]

  @@index([negocio_id])
}

model checklist_items {
  id           BigInt                       @id @default(autoincrement())
  checklist_id BigInt
  texto        String
  orden        Int                          @default(0)
  checklists   checklists                   @relation(fields: [checklist_id], references: [id], onDelete: Cascade)
  resultados   checklist_item_resultados[]

  @@index([checklist_id])
}

model checklist_instancias {
  id           BigInt                      @id @default(autoincrement())
  checklist_id BigInt
  fecha        DateTime                    @db.Date
  estado       String                      @default("abierta")
  checklists   checklists                  @relation(fields: [checklist_id], references: [id], onDelete: Cascade)
  resultados   checklist_item_resultados[]

  @@unique([checklist_id, fecha])
  @@index([checklist_id])
}

model checklist_item_resultados {
  id            BigInt               @id @default(autoincrement())
  instancia_id  BigInt
  item_id       BigInt
  completado    Boolean              @default(false)
  usuario_id    BigInt?
  completado_at DateTime?            @db.Timestamptz(6)
  instancia     checklist_instancias @relation(fields: [instancia_id], references: [id], onDelete: Cascade)
  item          checklist_items      @relation(fields: [item_id], references: [id], onDelete: Cascade)
  usuarios      usuarios?            @relation(fields: [usuario_id], references: [id])

  @@unique([instancia_id, item_id])
  @@index([instancia_id])
}

// ===========================================================================
//  SILVIA — coach de negocio con IA y memoria (feature extra)
// ===========================================================================

model silvia_mensajes {
  id         BigInt   @id @default(autoincrement())
  negocio_id BigInt
  rol        String   // 'user' | 'assistant'
  contenido  String
  creado_at  DateTime @default(now()) @db.Timestamptz(6)
  negocios   negocios @relation(fields: [negocio_id], references: [id])

  @@index([negocio_id])
}

model silvia_memoria {
  id         BigInt    @id @default(autoincrement())
  negocio_id BigInt
  tipo       String    // 'evento' | 'aprendizaje' | 'nota'
  contenido  String
  fecha      DateTime? @db.Date
  creado_at  DateTime  @default(now()) @db.Timestamptz(6)
  negocios   negocios  @relation(fields: [negocio_id], references: [id])

  @@index([negocio_id])
}
